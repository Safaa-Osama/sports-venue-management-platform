# ==============================================================================
# Application Configuration
# ==============================================================================
PORT=3000
NODE_ENV=development
ORIGINS=http://localhost:3000,http://localhost:5000

# ==============================================================================
# Database Configuration (MongoDB)
# ==============================================================================
DB_LOCAL=mongodb://127.0.0.1:27017/SportVenues
DB_URI_ATLAS=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/SportVenues?retryWrites=true&w=majority

# ==============================================================================
# In-Memory Cache & Distributed Lock (Redis)
# ==============================================================================
REDIS_URI=rediss://default:<password>@<host>.upstash.io:6379

# ==============================================================================
# Authentication & JWT Secrets
# ==============================================================================
SALT_ROUND=10
PREFIX_USER=Bearer
PREFIX_ADMIN=admin
SECRET_KEY_USER=your_super_secret_jwt_key_for_users
SECRET_KEY_ADMIN=your_super_secret_jwt_key_for_admins
REFRESH_SECRET_KEY_USER=your_refresh_secret_key_for_users
REFRESH_SECRET_KEY_ADMIN=your_refresh_secret_key_for_admins
ENCRYPTION_KEY=your_encryption_secret_key_16_or_32_chars

# Google OAuth 2.0
CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Initial Super Admin Seed (Optional overrides)
INITIAL_ADMIN_EMAIL=admin@venue.com
INITIAL_ADMIN_PASSWORD=Admin@123456

# ==============================================================================
# Email Service (Nodemailer / SMTP)
# ==============================================================================
EMAIL=your-email@gmail.com
PASS=your-app-specific-password
TOEMAIL=support-recipient@example.com

# ==============================================================================
# Object Storage (AWS S3 / Cloudflare R2)
# ==============================================================================
AWS_REGION=us-east-1
AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
AWS_BUCKET_NAME=arenahub
AWS_ACCESS_KEY=your_aws_or_r2_access_key
AWS_SECRET_ACCESS_KEY=your_aws_or_r2_secret_key
AWS_APP_NAME=ArenaHub-app

# ==============================================================================
# Payment Gateway (Paymob Egypt)
# ==============================================================================
PAYMOB_SECRET_KEY=egy_sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYMOB_PUBLIC_KEY=egy_pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYMOB_INTEGRATION_ID=1234567
PAYMOB_HMAC_SECRET=YOUR_PAYMOB_HMAC_SECRET_HASH
